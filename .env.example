# Admin Panel Credentials — SAFE TO COMMIT (no real secret values here)
# Copy this to .env for local development.
# On Vercel: add these in Project → Settings → Environment Variables

# ── Admin Auth ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_PIN=
JWT_SECRET=

# ── GitHub REST API Storage (Production CMS) ────────────────────────────────
# Personal Access Token (PAT) with 'repo' contents read/write permissions
# Create at https://github.com/settings/tokens (classic with 'repo' scope or Fine-grained)
GITHUB_TOKEN=

# Repository Configuration
GITHUB_OWNER=urk23cs1262
GITHUB_REPO=nivesh-portfolio
GITHUB_BRANCH=main
